@prefix gha: <http://seanchatmangpt.github.io/packs/github-actions#> .
@prefix ex: <https://ggen.io/ecosystem/github-sync#> .

# Authored semantic input for the ecosystem bootstrap rail.
# github-actions-pack + ggen sync run owns the workflow YAML.
#
# 2026-08-28: binary-download consumption (curl a release tarball, sha256sum --check) replaced
# with real git submodules (vendor/ggen, vendor/ggen-marketplace -- see .gitmodules) plus a
# composed container image (ghcr.io/seanchatmangpt/ggen-ecosystem) that bundles a real `ggen`
# binary built from vendor/ggen and the real vendor/ggen-marketplace/packs/. The construct job now
# runs inside that pinned container instead of installing a binary on the bare runner.
ex:workflow
    a gha:Workflow ;
    gha:fileName "ggen-ecosystem-sync.yml" ;
    gha:purpose "GGen Ecosystem Sync" ;
    gha:permissionCeiling "contents: read" ;
    gha:trigger gha:EventWorkflowDispatch ;
    gha:noPushTriggerReason "reusable workflow_call target with explicit manual replay" ;
    gha:onBlock """workflow_call:
  inputs:
    ggen_container_tag:
      description: Exact tag of the composed ggen-ecosystem container (ggen binary + marketplace packs)
      required: false
      type: string
      default: v26.8.28
    marketplace_sha:
      description: Exact ggen marketplace commit required by every pack (must match vendor/ggen-marketplace submodule pin)
      required: false
      type: string
      default: c779aec20d9c93727c7ad4464f1dd52ac8e066e4
    working_directory:
      description: Repository relative directory containing ggen.toml
      required: false
      type: string
      default: .
    dry_run:
      description: Run the same manufacture rail without writing projections
      required: false
      type: boolean
      default: false
    artifact_retention_days:
      description: Retention for replay evidence
      required: false
      type: number
      default: 7
workflow_dispatch:
  inputs:
    ggen_container_tag:
      description: Exact tag of the composed ggen-ecosystem container (ggen binary + marketplace packs)
      required: true
      type: string
      default: v26.8.28
    marketplace_sha:
      description: Exact ggen marketplace commit required by every pack (must match vendor/ggen-marketplace submodule pin)
      required: true
      type: string
      default: c779aec20d9c93727c7ad4464f1dd52ac8e066e4
    working_directory:
      description: Repository relative directory containing ggen.toml
      required: true
      type: string
      default: .
    dry_run:
      description: Run without writing generated projections
      required: true
      type: boolean
      default: false
    artifact_retention_days:
      description: Retention for replay evidence
      required: true
      type: number
      default: 7""" ;
    gha:concurrencyPolicy """group: ggen-ecosystem-sync-${{ github.repository }}-${{ github.ref }}-${{ inputs.working_directory }}
cancel-in-progress: false""" ;
    gha:evidenceObligation "bind exact candidate SHA, composed container digest, marketplace submodule SHA, pack identities, generated patch digest, intrinsic GGen receipt, and GitHub run identity" ;
    gha:standingEffect "successful execution proves read-only deterministic manufacture inside the pinned composed container; repository mutation authority remains external" .

ex:construct
    a gha:Job ;
    gha:inWorkflow ex:workflow ;
    gha:jobName "construct" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 20 ;
    gha:jobPermissions "contents: read" ;
    gha:jobExtra """name: Deterministic ecosystem manufacture
container:
  image: ghcr.io/seanchatmangpt/ggen-ecosystem:${{ inputs.ggen_container_tag }}""" ;
    gha:evidenceEmitted "immutable patch and replay receipt artifact" ;
    gha:failureClassification "REFUSED or BUILD_BROKEN before repository write authority exists" .

ex:checkout
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 1 ;
    gha:stepName "Checkout exact candidate" ;
    gha:usesAction "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1" ;
    gha:withParam "ref: ${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}" ;
    gha:withParam "fetch-depth: 0" ;
    gha:withParam "persist-credentials: false" ;
    gha:withParam "submodules: recursive" .

ex:admit
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 2 ;
    gha:stepName "Admit immutable producer and pack identities" ;
    gha:envVar "CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}" ;
    gha:envVar "GGEN_CONTAINER_TAG: ${{ inputs.ggen_container_tag }}" ;
    gha:envVar "MARKETPLACE_SHA: ${{ inputs.marketplace_sha }}" ;
    gha:envVar "GGEN_WORKING_DIRECTORY: ${{ inputs.working_directory }}" ;
    gha:runCommand """set -euo pipefail
# Container-job reality on HOSTED runners (not reproduced by local `act`,
# which maps UIDs differently): the workspace is checked out owned by the
# host runner user while this step runs as the container's user, so every
# bare `git` call dies with "fatal: detected dubious ownership" -- making
# `$(git rev-parse HEAD)` expand to empty and the head-mismatch refusal
# below fire spuriously on EVERY hosted run. Found by the first real
# external caller (seanchatmangpt/beam4pm PR #22). Declaring the workspace
# and its submodule safe is scoped to this job's ephemeral container HOME.
git config --global --add safe.directory "$GITHUB_WORKSPACE"
git config --global --add safe.directory "$GITHUB_WORKSPACE/vendor/ggen-marketplace"
[[ "$(git rev-parse HEAD)" = "$CANDIDATE_SHA" ]] || { echo 'REFUSED[EXACT_HEAD_MISMATCH]' >&2; exit 2; }
[[ "$MARKETPLACE_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo 'REFUSED[INVALID_MARKETPLACE_SHA]' >&2; exit 2; }
submodule_sha="$(git -C vendor/ggen-marketplace rev-parse HEAD)"
[[ "$submodule_sha" = "$MARKETPLACE_SHA" ]] || { echo "REFUSED[MARKETPLACE_SUBMODULE_DRIFT]:${submodule_sha}:${MARKETPLACE_SHA}" >&2; exit 2; }
mkdir -p "$RUNNER_TEMP/ggen-ecosystem-evidence"
export GGEN_PACK_RECEIPT="$RUNNER_TEMP/ggen-ecosystem-evidence/packs.json"
python3 - <<'PY'
import json, os, tomllib
from pathlib import Path, PurePosixPath
workspace = Path(os.environ['GITHUB_WORKSPACE']).resolve()
root = (workspace / os.environ['GGEN_WORKING_DIRECTORY']).resolve()
if root != workspace and workspace not in root.parents:
    raise SystemExit('REFUSED[WORKING_DIRECTORY_ESCAPES_WORKSPACE]')
manifest = root / 'ggen.toml'
if not manifest.is_file():
    raise SystemExit('REFUSED[GGEN_MANIFEST_MISSING]')
doc = tomllib.loads(manifest.read_text())
packs = doc.get('packs')
if not isinstance(packs, dict) or not packs:
    raise SystemExit('REFUSED[MARKETPLACE_PACKS_REQUIRED]')
admitted = []
for alias, ref in sorted(packs.items()):
    if not isinstance(ref, dict):
        raise SystemExit(f'REFUSED[PACK_REF_NOT_TABLE]:{alias}')
    path = str(ref.get('path', ''))
    if not path:
        raise SystemExit(f'REFUSED[PACK_REF_NOT_PATH_SOURCED]:{alias}')
    sub = PurePosixPath(path)
    if sub.is_absolute() or '..' in sub.parts or sub.parts[:2] != ('vendor', 'ggen-marketplace'):
        raise SystemExit(f'REFUSED[INVALID_MARKETPLACE_SUBMODULE_PATH]:{alias}:{path}')
    admitted.append({'alias': alias, 'path': path})
Path(os.environ['GGEN_PACK_RECEIPT']).write_text(json.dumps(admitted, indent=2, sort_keys=True) + chr(10))
print(f'ALIVE: admitted {len(admitted)} submodule-sourced marketplace pack(s) at {os.environ["MARKETPLACE_SHA"]}')
PY""" .

ex:cache
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 3 ;
    gha:stepName "Restore untrusted native GGen pack cache" ;
    gha:usesAction "actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0" ;
    gha:withParam "path: ${{ inputs.working_directory }}/.ggen-v2/git-packs" ;
    gha:withParam "key: ggen-git-packs-${{ runner.os }}-${{ inputs.marketplace_sha }}" .

ex:sync
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 4 ;
    gha:stepName "Manufacture with ggen sync run (ggen preinstalled in the composed container)" ;
    gha:stepId "sync" ;
    gha:continueOnError true ;
    gha:envVar "GGEN_WORKING_DIRECTORY: ${{ inputs.working_directory }}" ;
    gha:envVar "GGEN_DRY_RUN: ${{ inputs.dry_run }}" ;
    gha:runCommand """set -uo pipefail
mkdir -p "$RUNNER_TEMP/ggen-ecosystem-evidence"
set +e
if [[ "$GGEN_DRY_RUN" = true ]]; then
  (cd "$GGEN_WORKING_DIRECTORY" && ggen sync run --dry-run) > >(tee "$RUNNER_TEMP/ggen-ecosystem-evidence/stdout.log") 2> >(tee "$RUNNER_TEMP/ggen-ecosystem-evidence/stderr.log" >&2)
else
  (cd "$GGEN_WORKING_DIRECTORY" && ggen sync run) > >(tee "$RUNNER_TEMP/ggen-ecosystem-evidence/stdout.log") 2> >(tee "$RUNNER_TEMP/ggen-ecosystem-evidence/stderr.log" >&2)
fi
exit_code=$?
set -e
echo "exit_code=$exit_code" >> "$GITHUB_OUTPUT"
echo "$exit_code" > "$RUNNER_TEMP/ggen-ecosystem-evidence/sync-exit-code.txt\"""" .

ex:evidence
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 5 ;
    gha:stepName "Bind generated consequence into replay receipt" ;
    gha:condition "always()" ;
    gha:envVar "CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}" ;
    gha:envVar "GGEN_CONTAINER_TAG: ${{ inputs.ggen_container_tag }}" ;
    gha:envVar "MARKETPLACE_SHA: ${{ inputs.marketplace_sha }}" ;
    gha:envVar "GGEN_WORKING_DIRECTORY: ${{ inputs.working_directory }}" ;
    gha:envVar "SYNC_EXIT_CODE: ${{ steps.sync.outputs.exit_code }}" ;
    gha:runCommand """set -euo pipefail
tmp="$RUNNER_TEMP/ggen-ecosystem-evidence"
if [[ -f "$GGEN_WORKING_DIRECTORY/.ggen-v2/receipt.json" ]]; then cp "$GGEN_WORKING_DIRECTORY/.ggen-v2/receipt.json" "$tmp/ggen-receipt.json"; fi
if [[ -f "$GGEN_WORKING_DIRECTORY/ggen.lock" ]]; then cp "$GGEN_WORKING_DIRECTORY/ggen.lock" "$tmp/ggen.lock"; fi
rm -rf "$GGEN_WORKING_DIRECTORY/.ggen-v2"
git add -A -- "$GGEN_WORKING_DIRECTORY"
git diff --cached --check
git diff --cached --binary --no-ext-diff > "$tmp/ggen-sync.patch"
git reset --quiet
python3 - <<'PY'
import hashlib, json, os
from pathlib import Path
root = Path(os.environ['RUNNER_TEMP']) / 'ggen-ecosystem-evidence'
def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as fh:
        for chunk in iter(lambda: fh.read(1048576), b''):
            h.update(chunk)
    return h.hexdigest()
patch = root / 'ggen-sync.patch'
receipt = {
  'schema': 'https://ggen.dev/receipts/ecosystem-sync/v2',
  'repository': os.environ['GITHUB_REPOSITORY'],
  'source_sha': os.environ['CANDIDATE_SHA'],
  'run_id': os.environ['GITHUB_RUN_ID'],
  'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],
  'ggen_container_image': 'ghcr.io/seanchatmangpt/ggen-ecosystem',
  'ggen_container_tag': os.environ['GGEN_CONTAINER_TAG'],
  'marketplace_sha': os.environ['MARKETPLACE_SHA'],
  'working_directory': os.environ['GGEN_WORKING_DIRECTORY'],
  'packs': json.loads((root / 'packs.json').read_text()),
  'sync_command': 'ggen sync run',
  'sync_exit_code': os.environ.get('SYNC_EXIT_CODE'),
  'patch_sha256': digest(patch)
}
(root / 'ecosystem-sync-receipt.json').write_text(json.dumps(receipt, indent=2, sort_keys=True) + chr(10))
PY
sha256sum "$tmp/ggen-sync.patch" "$tmp/ecosystem-sync-receipt.json" "$tmp/packs.json" > "$tmp/SHA256SUMS\"""" .

ex:upload
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 6 ;
    gha:stepName "Upload deterministic replay evidence" ;
    gha:condition "always()" ;
    gha:usesAction "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1" ;
    gha:withParam "name: ggen-ecosystem-sync-${{ github.run_id }}-${{ github.run_attempt }}" ;
    gha:withParam "path: ${{ runner.temp }}/ggen-ecosystem-evidence/" ;
    gha:withParam "if-no-files-found: error" ;
    gha:withParam "retention-days: ${{ inputs.artifact_retention_days }}" .

ex:enforce
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 7 ;
    gha:stepName "Enforce GGen sync standing" ;
    gha:condition "always()" ;
    gha:envVar "SYNC_EXIT_CODE: ${{ steps.sync.outputs.exit_code }}" ;
    gha:runCommand """if [[ "${SYNC_EXIT_CODE:-not-run}" != 0 ]]; then
  echo "BUILD_BROKEN[GGEN_SYNC_RUN_FAILED]:${SYNC_EXIT_CODE:-not-run}" >&2
  exit 1
fi""" .

ex:summarizeReceipt
    a gha:Step ;
    gha:inJob ex:construct ; gha:stepOrder 8 ;
    gha:stepName "Summarize sync receipt to job summary" ;
    gha:condition "always()" ;
    gha:runCommand """{
  echo "### GGen sync receipt"
  echo
  if [[ -f ggen.lock ]]; then
    echo '```'
    cat ggen.lock
    echo '```'
  else
    echo "no ggen.lock found"
  fi
} >> "$GITHUB_STEP_SUMMARY"
""" .

# --- Composed container build + publish -----------------------------------------------------
# Builds ghcr.io/seanchatmangpt/ggen-ecosystem from ./Dockerfile (real `ggen` binary built from
# the vendor/ggen submodule + real vendor/ggen-marketplace/packs/ copied in). Pattern follows the
# real, proven ~/ggen/.github/workflows/docker-build-push.yml (GHCR login, docker/build-push-
# action, tag-triggered), not invented from scratch.
ex:containerWorkflow
    a gha:Workflow ;
    gha:fileName "ggen-ecosystem-container.yml" ;
    gha:purpose "GGen Ecosystem Container Build & Publish" ;
    gha:permissionCeiling "contents: read" ;
    gha:trigger gha:EventWorkflowDispatch ;
    gha:noPushTriggerReason "container publish gated on manual/tag replay, not every push" ;
    gha:onBlock """workflow_dispatch:
  inputs:
    image_tag:
      description: Tag to publish the composed image under
      required: true
      type: string
push:
  tags:
    - 'v[0-9]+.[0-9]+.[0-9]+'""" ;
    gha:evidenceObligation "bind exact candidate SHA, submodule commits, and the published image digest" ;
    gha:standingEffect "a pushed image is evidence only for the exact submodule commits and Dockerfile content that produced it" .

# Real, evidence-driven design (2026-08-29): a single job with QEMU +
# `platforms: linux/amd64,linux/arm64` was tried first and genuinely hit
# its own 120-minute job timeout (run 33244628216, started 09:04:37Z,
# cancelled 11:04:54Z -- exactly 120:17 elapsed) mid-compile of the
# QEMU-emulated arm64 half; QEMU cross-compilation of a full Rust
# workspace with LTO is too slow for any reasonable CI budget. Replaced
# with the correct pattern: two NATIVE per-architecture build jobs (no
# QEMU at all) using GitHub's free public-repo arm64-hosted runner
# (`ubuntu-24.04-arm`, confirmed real via
# https://github.blog/changelog/2025-01-16-linux-arm64-hosted-runners-now-available-for-free-in-public-repositories-public-preview/),
# each pushing its own single-platform tag, then a merge job combines them
# into one real multi-arch manifest list via `docker buildx imagetools
# create` -- no image rebuild, just a manifest-list assembly, seconds not
# hours.

ex:containerBuildAmd64
    a gha:Job ;
    gha:inWorkflow ex:containerWorkflow ;
    gha:jobName "build-amd64" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 30 ;
    gha:jobPermissions """contents: read
packages: write""" ;
    gha:jobExtra "name: Build and push linux/amd64 image" ;
    gha:evidenceEmitted "published linux/amd64 image digest" ;
    gha:failureClassification "BUILD_BROKEN if the amd64 build fails" .

ex:containerAmd64Checkout
    a gha:Step ;
    gha:inJob ex:containerBuildAmd64 ; gha:stepOrder 1 ;
    gha:stepName "Checkout with submodules" ;
    gha:usesAction "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1" ;
    gha:withParam "submodules: recursive" ;
    gha:withParam "persist-credentials: false" .

ex:containerAmd64Login
    a gha:Step ;
    gha:inJob ex:containerBuildAmd64 ; gha:stepOrder 2 ;
    gha:stepName "Log in to GHCR" ;
    gha:usesAction "docker/login-action@74a5d142397b4f367a81961eba4e8cd7edddf772 # v3" ;
    gha:withParam "registry: ghcr.io" ;
    gha:withParam "username: ${{ github.actor }}" ;
    gha:withParam "password: ${{ secrets.GITHUB_TOKEN }}" .

ex:containerAmd64Buildx
    a gha:Step ;
    gha:inJob ex:containerBuildAmd64 ; gha:stepOrder 3 ;
    gha:stepName "Set up Docker Buildx" ;
    gha:usesAction "docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3" .

ex:containerAmd64BuildPush
    a gha:Step ;
    gha:inJob ex:containerBuildAmd64 ; gha:stepOrder 4 ;
    gha:stepName "Build and push linux/amd64" ;
    gha:usesAction "docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6" ;
    gha:withParam "context: ." ;
    gha:withParam "push: true" ;
    gha:withParam "platforms: linux/amd64" ;
    # SBOM + SLSA provenance attestation (2026-08-29): docker/build-push-action@v6's
    # real action.yml (verified at the pinned SHA 10e90e3645eae34f1e60eeb005ba3a3d33f178e8,
    # https://github.com/docker/build-push-action/blob/10e90e3645eae34f1e60eeb005ba3a3d33f178e8/action.yml)
    # declares `sbom` and `provenance` as native Bool/String inputs -- shorthand for
    # --attest=type=sbom and --attest=type=provenance respectively. No custom
    # attest-type wiring needed; the boolean with-params below are sufficient.
    gha:withParam "sbom: true" ;
    gha:withParam "provenance: true" ;
    # Real cache fix (2026-08-29): GitHub-hosted runners are a fresh VM per
    # job -- local BuildKit cache mounts never persist across separate
    # workflow runs. cache-from/cache-to type=gha is the actual mechanism
    # that persists build-layer cache (including this cargo build layer)
    # across runs via GitHub's own Actions cache service. Scoped per
    # architecture (amd64/arm64 build independently, different layer
    # digests, must not share one cache key).
    gha:withParam "cache-from: type=gha,scope=ggen-ecosystem-amd64" ;
    gha:withParam "cache-to: type=gha,mode=max,scope=ggen-ecosystem-amd64" ;
    gha:withParam "tags: ghcr.io/seanchatmangpt/ggen-ecosystem:${{ inputs.image_tag || github.ref_name }}-amd64" .

ex:containerBuildArm64
    a gha:Job ;
    gha:inWorkflow ex:containerWorkflow ;
    gha:jobName "build-arm64" ;
    gha:runner "ubuntu-24.04-arm" ;
    gha:timeoutMinutes 30 ;
    gha:jobPermissions """contents: read
packages: write""" ;
    gha:jobExtra "name: Build and push linux/arm64 image" ;
    gha:evidenceEmitted "published linux/arm64 image digest" ;
    gha:failureClassification "BUILD_BROKEN if the arm64 build fails" .

ex:containerArm64Checkout
    a gha:Step ;
    gha:inJob ex:containerBuildArm64 ; gha:stepOrder 1 ;
    gha:stepName "Checkout with submodules" ;
    gha:usesAction "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1" ;
    gha:withParam "submodules: recursive" ;
    gha:withParam "persist-credentials: false" .

ex:containerArm64Login
    a gha:Step ;
    gha:inJob ex:containerBuildArm64 ; gha:stepOrder 2 ;
    gha:stepName "Log in to GHCR" ;
    gha:usesAction "docker/login-action@74a5d142397b4f367a81961eba4e8cd7edddf772 # v3" ;
    gha:withParam "registry: ghcr.io" ;
    gha:withParam "username: ${{ github.actor }}" ;
    gha:withParam "password: ${{ secrets.GITHUB_TOKEN }}" .

ex:containerArm64Buildx
    a gha:Step ;
    gha:inJob ex:containerBuildArm64 ; gha:stepOrder 3 ;
    gha:stepName "Set up Docker Buildx" ;
    gha:usesAction "docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3" .

ex:containerArm64BuildPush
    a gha:Step ;
    gha:inJob ex:containerBuildArm64 ; gha:stepOrder 4 ;
    gha:stepName "Build and push linux/arm64" ;
    gha:usesAction "docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6" ;
    gha:withParam "context: ." ;
    gha:withParam "push: true" ;
    gha:withParam "platforms: linux/arm64" ;
    # SBOM + SLSA provenance attestation (2026-08-29): same native `sbom`/`provenance`
    # Bool/String inputs verified on the amd64 step above -- see that step's comment
    # for the exact action.yml source citation.
    gha:withParam "sbom: true" ;
    gha:withParam "provenance: true" ;
    gha:withParam "cache-from: type=gha,scope=ggen-ecosystem-arm64" ;
    gha:withParam "cache-to: type=gha,mode=max,scope=ggen-ecosystem-arm64" ;
    gha:withParam "tags: ghcr.io/seanchatmangpt/ggen-ecosystem:${{ inputs.image_tag || github.ref_name }}-arm64" .

# Real, Fortune-5-table-stake supply-chain step (2026-08-29): keyless container
# signing via cosign + GitHub OIDC (sigstore). No long-lived signing key exists
# anywhere in this repo or its secrets -- the runner's own OIDC identity token
# (job permission `id-token: write`) is exchanged with Sigstore's public Fulcio
# CA for a short-lived signing certificate, the signature is produced entirely
# in-memory, and the resulting signature + certificate + transparency-log
# inclusion proof are published to the public Rekor log and to the GHCR
# registry alongside the image -- the real cosign-installer + `cosign sign
# --yes <image>@<digest>` pattern documented at
# https://github.com/sigstore/cosign-installer (README "Keyless Signing
# Example with GitHub OIDC") and https://docs.sigstore.dev/cosign/signing/overview/,
# verified against the action's real published action.yml/README before
# pinning below (not assumed). `sigstore/cosign-installer` pinned to the exact
# commit SHA of its real v4.1.2 tag, resolved via `git ls-remote --tags
# https://github.com/sigstore/cosign-installer.git` on 2026-08-29 -- not a
# floating tag, and not a version number invented without checking.
ex:containerMerge
    a gha:Job ;
    gha:inWorkflow ex:containerWorkflow ;
    gha:jobName "merge-manifest" ;
    gha:runner "ubuntu-24.04" ;
    gha:timeoutMinutes 10 ;
    gha:dependsOn ex:containerBuildAmd64 ;
    gha:dependsOn ex:containerBuildArm64 ;
    gha:jobPermissions """contents: read
packages: write
id-token: write
security-events: write""" ;
    gha:jobExtra "name: Merge into one multi-arch manifest" ;
    gha:evidenceEmitted "published multi-arch manifest list digest, real per-platform digests underneath, a keyless cosign signature (Fulcio cert + Rekor transparency-log entry) over that manifest-list digest, and a Trivy SARIF vulnerability report uploaded to GitHub code scanning" ;
    gha:failureClassification "BUILD_BROKEN if manifest assembly fails; BUILD_BROKEN if keyless cosign signing fails" .

ex:containerMergeLogin
    a gha:Step ;
    gha:inJob ex:containerMerge ; gha:stepOrder 1 ;
    gha:stepName "Log in to GHCR" ;
    gha:usesAction "docker/login-action@74a5d142397b4f367a81961eba4e8cd7edddf772 # v3" ;
    gha:withParam "registry: ghcr.io" ;
    gha:withParam "username: ${{ github.actor }}" ;
    gha:withParam "password: ${{ secrets.GITHUB_TOKEN }}" .

ex:containerMergeCreate
    a gha:Step ;
    gha:inJob ex:containerMerge ; gha:stepOrder 2 ;
    gha:stepName "Create and push multi-arch manifest" ;
    gha:runCommand """set -euo pipefail
TAG="${{ inputs.image_tag || github.ref_name }}"
docker buildx imagetools create \\
  -t "ghcr.io/seanchatmangpt/ggen-ecosystem:${TAG}" \\
  -t "ghcr.io/seanchatmangpt/ggen-ecosystem:latest" \\
  "ghcr.io/seanchatmangpt/ggen-ecosystem:${TAG}-amd64" \\
  "ghcr.io/seanchatmangpt/ggen-ecosystem:${TAG}-arm64"
docker buildx imagetools inspect "ghcr.io/seanchatmangpt/ggen-ecosystem:${TAG}"
""" .

ex:containerMergeCosignInstall
    a gha:Step ;
    gha:inJob ex:containerMerge ; gha:stepOrder 3 ;
    gha:stepName "Install cosign" ;
    gha:usesAction "sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6 # v4.1.2" .

ex:containerMergeCosignSign
    a gha:Step ;
    gha:inJob ex:containerMerge ; gha:stepOrder 4 ;
    gha:stepName "Sign multi-arch manifest keylessly (cosign + GitHub OIDC)" ;
    gha:runCommand """set -euo pipefail
TAG="${{ inputs.image_tag || github.ref_name }}"
IMAGE="ghcr.io/seanchatmangpt/ggen-ecosystem:${TAG}"
DIGEST=$(docker buildx imagetools inspect "${IMAGE}" --format "{{json .Manifest}}" | jq -r '.digest')
echo "Signing ${IMAGE}@${DIGEST} keylessly via GitHub OIDC (no signing key in this repo)"
cosign sign --yes "${IMAGE}@${DIGEST}"
""" .

# Real container CVE scanning (2026-08-29): CodeQL (see .github/workflows/codeql.yml, hand-
# authored, outside this ggen-generated rail) scans SOURCE only -- it never inspects the
# published image's OS packages/dependency layers. Trivy against the just-published multi-arch
# manifest closes that orthogonal gap: known-CVE table stakes for a Fortune-5 supply chain,
# scanning the exact artifact that ships, not the source that built it. Ref resolved for real,
# not assumed: `git ls-remote --tags https://github.com/aquasecurity/trivy-action.git` ->
# v0.36.0 tag dereferences to commit ed142fd0673e97e23eac54620cfb913e5ce36c25 (confirmed against
# the real GitHub release page, commit SHA ed142fd0673e97e23eac54620cfb913e5ce36c25, and its real
# action.yaml at that commit exposing image-ref/format/output inputs). SARIF upload target
# likewise resolved via `git ls-remote --tags https://github.com/github/codeql-action.git` ->
# v4.37.9 dereferences to commit cdf488f595d80d6e07e03d4674febd5ab45fa938, whose real
# upload-sarif/action.yml at that commit exposes the sarif_file input used below. Ordered after
# cosign signing (stepOrder 5-6) so scanning covers the exact signed artifact.
ex:containerMergeTrivyScan
    a gha:Step ;
    gha:inJob ex:containerMerge ; gha:stepOrder 5 ;
    gha:stepName "Run Trivy vulnerability scanner on published image" ;
    gha:usesAction "aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0" ;
    gha:withParam "image-ref: ghcr.io/seanchatmangpt/ggen-ecosystem:${{ inputs.image_tag || github.ref_name }}" ;
    gha:withParam "format: sarif" ;
    gha:withParam "output: trivy-results.sarif" .

ex:containerMergeSarifUpload
    a gha:Step ;
    gha:inJob ex:containerMerge ; gha:stepOrder 6 ;
    gha:stepName "Upload Trivy scan results to GitHub code scanning" ;
    gha:condition "always()" ;
    gha:usesAction "github/codeql-action/upload-sarif@cdf488f595d80d6e07e03d4674febd5ab45fa938 # v4.37.9" ;
    gha:withParam "sarif_file: trivy-results.sarif" .
