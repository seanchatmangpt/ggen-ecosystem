  scb:semanticFingerprint "SCB-004:provenance-subject-count" ;
  scb:mutationJson """{"path":"provenance.subject","value":[]}""" ;
  scb:assertionJson """{"op":"len_eq","path":"provenance.subject","value":1}""" .

