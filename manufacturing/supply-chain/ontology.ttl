@prefix scb: <https://seanchatmangpt.github.io/ggen-marketplace/supply-chain-evidence#> .
@prefix ex: <https://seanchatmangpt.github.io/ggen-ecosystem/supply-chain-evidence#> .

ex:court a scb:Court ;
  scb:outputPath "generated/supply-chain-evidence-cases.json" ;
  scb:caseCount 75 .

ex:case002 a scb:CourtCase ;
  scb:caseId "SCB-002" ;
  scb:ordinal 2 ;
  scb:title "valid bundle" ;
  scb:expectedStanding "ALIVE" ;
  scb:lawFamily "cross-format" ;
  scb:semanticFingerprint "SCB-002:valid-bundle" ;
  scb:mutationJson """{}""" ;
  scb:assertionJson """{"op":"always"}""" .

ex:case003 a scb:CourtCase ;
  scb:caseId "SCB-003" ;
  scb:ordinal 3 ;
  scb:title "provenance statement type" ;
  scb:expectedStanding "REFUSED[PROV_TYPE]" ;
  scb:lawFamily "slsa" ;
  scb:semanticFingerprint "SCB-003:provenance-statement-type" ;
  scb:mutationJson """{"path":"provenance._type","value":"https://in-toto.io/Statement/v0.1"}""" ;
  scb:assertionJson """{"op":"eq","path":"provenance._type","value":"https://in-toto.io/Statement/v1"}""" .

ex:case004 a scb:CourtCase ;
  scb:caseId "SCB-004" ;
