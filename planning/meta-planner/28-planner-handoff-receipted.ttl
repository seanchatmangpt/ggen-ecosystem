@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-28-planner-handoff-receipted a eco:PlannerSelectionContract ; dcterms:identifier "MP-028" ; skos:prefLabel "planner handoff receipt" ; eco:hypothesis "Planner handoff consequence must be receipted" ; eco:authorityCeiling "CONSTRUCT" ; eco:failureStanding "UNKNOWN" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .