@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-34-planner-output-is-intent a eco:PlannerSelectionContract ; dcterms:identifier "MP-034" ; skos:prefLabel "planner output" ; eco:hypothesis "Planner output is intent/construct, not actuation" ; eco:authorityCeiling "CONSTRUCT" ; eco:failureStanding "REFUSED:PLANNER_ACTUATION" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .