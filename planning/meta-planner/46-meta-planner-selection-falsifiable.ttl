@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-46-meta-planner-selection-falsifiable a eco:PlannerSelectionContract ; dcterms:identifier "MP-046" ; skos:prefLabel "selection falsifier" ; eco:hypothesis "Meta-planner choice must have a falsifier" ; eco:authorityCeiling "SELECT" ; eco:failureStanding "UNKNOWN" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .