@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-32-plan-does-not-grant-do a eco:PlannerSelectionContract ; dcterms:identifier "MP-032" ; skos:prefLabel "plan authority fence" ; eco:hypothesis "A plan never grants itself DO authority" ; eco:authorityCeiling "CONSTRUCT" ; eco:failureStanding "REFUSED:PLAN_SELF_AUTHORITY" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .