@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-19-portfolio-not-collapsed-prematurely a eco:PlannerSelectionContract ; dcterms:identifier "MP-019" ; skos:prefLabel "portfolio option capital" ; eco:hypothesis "Preserve lawful planner options until evidence forces selection" ; eco:authorityCeiling "SELECT" ; eco:failureStanding "REFUSED:PREMATURE_SELECTION" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .