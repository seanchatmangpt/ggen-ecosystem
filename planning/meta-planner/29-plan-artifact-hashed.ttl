@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-29-plan-artifact-hashed a eco:PlannerSelectionContract ; dcterms:identifier "MP-029" ; skos:prefLabel "plan artifact hash" ; eco:hypothesis "Constructed plan artifact must bind a digest" ; eco:authorityCeiling "CONSTRUCT" ; eco:failureStanding "UNKNOWN" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .