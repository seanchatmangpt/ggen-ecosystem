@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-20-selection-rationale-recorded a eco:PlannerSelectionContract ; dcterms:identifier "MP-020" ; skos:prefLabel "selection rationale" ; eco:hypothesis "Meta-planner records why a planner was selected" ; eco:authorityCeiling "SELECT" ; eco:failureStanding "UNKNOWN" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .