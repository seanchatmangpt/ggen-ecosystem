@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-44-planner-failure-is-topology a eco:PlannerSelectionContract ; dcterms:identifier "MP-044" ; skos:prefLabel "failure topology" ; eco:hypothesis "Planner failure records topology rather than deleting the planner" ; eco:authorityCeiling "SELECT" ; eco:failureStanding "PARTIAL_ALIVE" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .