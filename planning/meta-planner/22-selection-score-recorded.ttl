@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-22-selection-score-recorded a eco:PlannerSelectionContract ; dcterms:identifier "MP-022" ; skos:prefLabel "selection score" ; eco:hypothesis "Selection score is bound to the exact episode" ; eco:authorityCeiling "SELECT" ; eco:failureStanding "UNKNOWN" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .