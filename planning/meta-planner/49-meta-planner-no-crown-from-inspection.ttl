@prefix eco: <https://ggen.io/ecosystem/meta-planner#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . eco:contract-49-meta-planner-no-crown-from-inspection a eco:PlannerSelectionContract ; dcterms:identifier "MP-049" ; skos:prefLabel "standing fence" ; eco:hypothesis "Inspection of planner output cannot crown ALIVE" ; eco:authorityCeiling "SELECT" ; eco:failureStanding "REFUSED:INSPECTION_AS_EXECUTION" ; eco:requiresExactSubject true ; eco:requiresFalsifier true ; eco:requiresReceipt true ; eco:preservesOptionCapital true .