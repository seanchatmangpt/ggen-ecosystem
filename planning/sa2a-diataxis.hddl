(define (domain sa2a-diataxis-rollout)
  (:requirements :typing :hierarchy)
  (:types repository)
  (:predicates
    (bound ?r - repository)
    (projected ?r - repository)
    (verified ?r - repository)
    (closed ?r - repository))
  (:task rollout :parameters (?r - repository))
  (:method rollout-by-projection
    :parameters (?r - repository)
    :task (rollout ?r)
    :ordered-subtasks (and
      (bind ?r)
      (project ?r)
      (verify ?r)
      (close ?r)))
  (:action bind :parameters (?r - repository)
    :effect (bound ?r))
  (:action project :parameters (?r - repository)
    :precondition (bound ?r)
    :effect (projected ?r))
  (:action verify :parameters (?r - repository)
    :precondition (projected ?r)
    :effect (verified ?r))
  (:action close :parameters (?r - repository)
    :precondition (verified ?r)
    :effect (closed ?r)))
