@prefix calc: <https://ggen.io/ecosystem/calculus#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix prov: <http://www.w3.org/ns/prov#> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . calc:no-ambient-do a skos:Concept, prov:Entity ; skos:inScheme calc:ArchitectureCalculus ; skos:prefLabel "No Ambient DO" ; dcterms:description "Ontology, planners, queries, templates, projections, hooks, and CI metadata receive no ambient DO authority." ; dcterms:source <https://github.com/seanchatmangpt/ggen-ecosystem/blob/main/AGENTS.md> .