@prefix calc: <https://ggen.io/ecosystem/calculus#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

calc:composition-root
    a skos:Concept, prov:Entity ;
    skos:inScheme calc:ArchitectureCalculus ;
    skos:prefLabel "Composition Root" ;
    dcterms:description "Canonical root that composes external repositories without centralizing their source." ;
    dcterms:source <https://github.com/seanchatmangpt/ggen-ecosystem/blob/main/docs/ARCHITECTURE.md> .
