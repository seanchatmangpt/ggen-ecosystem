@prefix calc: <https://ggen.io/ecosystem/calculus#> . @prefix dcterms: <http://purl.org/dc/terms/> . @prefix prov: <http://www.w3.org/ns/prov#> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . calc:publication-authority-separation a skos:Concept, prov:Entity ; skos:inScheme calc:ArchitectureCalculus ; skos:prefLabel "Publication Authority Separation" ; dcterms:description "Observation authority does not imply authority to publish non-public repository identities." ; dcterms:source <https://github.com/seanchatmangpt/ggen-ecosystem/blob/main/docs/ARCHITECTURE.md> .