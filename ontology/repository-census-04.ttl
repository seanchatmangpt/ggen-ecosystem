@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

eco:repo-candidate-ash_supabase a eco:RepositoryCandidate, prov:Entity ;
    dcterms:identifier "seanchatmangpt/ash_supabase" ;
    eco:sourceUrl "https://github.com/seanchatmangpt/ash_supabase" ;
    eco:censusStanding "CANDIDATE" ;
    eco:membershipBasis "observed-public-github-census; ecosystem-membership-not-admitted" ;
    eco:publicProjection true .

