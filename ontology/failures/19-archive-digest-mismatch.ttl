@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure19ArchiveDigestMismatch a eco:TypedFailure,skos:Concept; skos:prefLabel "ARCHIVE_DIGEST_MISMATCH"; eco:failurePhase "transport"; eco:standingOnFailure "REFUSED:ARCHIVE_DIGEST_MISMATCH"; eco:remediation "discard archive and reacquire exact SHA archive"; eco:retryPolicy "alternative-edge".
