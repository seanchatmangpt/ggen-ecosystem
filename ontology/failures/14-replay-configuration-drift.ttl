@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure14ReplayConfigurationDrift a eco:TypedFailure,skos:Concept; skos:prefLabel "REPLAY_CONFIGURATION_DRIFT"; eco:failurePhase "replay"; eco:standingOnFailure "REFUSED:REPLAY_CONFIGURATION_DRIFT"; eco:remediation "restore exact configuration identity"; eco:retryPolicy "same-subject".
