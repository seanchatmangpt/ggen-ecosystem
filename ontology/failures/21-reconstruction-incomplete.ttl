@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure21ReconstructionIncomplete a eco:TypedFailure,skos:Concept; skos:prefLabel "RECONSTRUCTION_INCOMPLETE"; eco:failurePhase "transport"; eco:standingOnFailure "BLOCKED"; eco:remediation "close dependency set before execution"; eco:retryPolicy "alternative-edge".
