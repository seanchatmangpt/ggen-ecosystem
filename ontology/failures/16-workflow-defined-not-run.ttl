@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure16WorkflowDefinedNotRun a eco:TypedFailure,skos:Concept; skos:prefLabel "WORKFLOW_DEFINED_NOT_RUN"; eco:failurePhase "standing"; eco:standingOnFailure "PARTIAL_ALIVE"; eco:remediation "execute workflow or local equivalent"; eco:retryPolicy "same-subject".
