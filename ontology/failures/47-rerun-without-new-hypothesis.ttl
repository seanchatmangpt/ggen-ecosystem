@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure47RerunWithoutNewHypothesis a eco:TypedFailure,skos:Concept; skos:prefLabel "RERUN_WITHOUT_NEW_HYPOTHESIS"; eco:failurePhase "diagnosis"; eco:standingOnFailure "REFUSED:RERUN_WITHOUT_NEW_HYPOTHESIS"; eco:remediation "state new causal hypothesis before retry"; eco:retryPolicy "same-subject".
