@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure15StandingWithoutExecution a eco:TypedFailure,skos:Concept; skos:prefLabel "STANDING_WITHOUT_EXECUTION"; eco:failurePhase "standing"; eco:standingOnFailure "REFUSED:STANDING_WITHOUT_EXECUTION"; eco:remediation "execute exact admitted subject before ALIVE"; eco:retryPolicy "same-subject".
