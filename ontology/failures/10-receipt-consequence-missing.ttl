@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure10ReceiptConsequenceMissing a eco:TypedFailure,skos:Concept; skos:prefLabel "RECEIPT_CONSEQUENCE_MISSING"; eco:failurePhase "receipt"; eco:standingOnFailure "PARTIAL_ALIVE"; eco:remediation "record observed consequence digest"; eco:retryPolicy "same-subject".
