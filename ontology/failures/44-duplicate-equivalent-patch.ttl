@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure44DuplicateEquivalentPatch a eco:TypedFailure,skos:Concept; skos:prefLabel "DUPLICATE_EQUIVALENT_PATCH"; eco:failurePhase "manufacture"; eco:standingOnFailure "REFUSED:DUPLICATE_EQUIVALENT_PATCH"; eco:remediation "dedupe by semantic fingerprint"; eco:retryPolicy "same-subject".
