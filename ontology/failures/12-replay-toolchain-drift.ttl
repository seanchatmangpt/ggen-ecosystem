@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure12ReplayToolchainDrift a eco:TypedFailure,skos:Concept; skos:prefLabel "REPLAY_TOOLCHAIN_DRIFT"; eco:failurePhase "replay"; eco:standingOnFailure "REFUSED:REPLAY_TOOLCHAIN_DRIFT"; eco:remediation "materialize pinned toolchain capsule"; eco:retryPolicy "same-subject".
