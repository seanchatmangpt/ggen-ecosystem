@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure50GgenSyncProvenanceFabrication a eco:TypedFailure,skos:Concept; skos:prefLabel "GGEN_SYNC_PROVENANCE_FABRICATION"; eco:failurePhase "provenance"; eco:standingOnFailure "REFUSED:PROVENANCE_FABRICATION"; eco:remediation "claim ggen sync only when command actually executed"; eco:retryPolicy "same-subject".
