@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure34SparqlParseFailure a eco:TypedFailure,skos:Concept; skos:prefLabel "SPARQL_PARSE_FAILURE"; eco:failurePhase "validation"; eco:standingOnFailure "BUILD_BROKEN"; eco:remediation "repair query grammar"; eco:retryPolicy "same-subject".
