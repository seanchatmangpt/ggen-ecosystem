@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure42MergeHeadMismatch a eco:TypedFailure,skos:Concept; skos:prefLabel "MERGE_HEAD_MISMATCH"; eco:failurePhase "git"; eco:standingOnFailure "REFUSED:MERGE_HEAD_MISMATCH"; eco:remediation "merge only inspected expected head SHA"; eco:retryPolicy "new-subject".
