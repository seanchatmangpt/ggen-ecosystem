@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure20ArtifactDigestMismatch a eco:TypedFailure,skos:Concept; skos:prefLabel "ARTIFACT_DIGEST_MISMATCH"; eco:failurePhase "transport"; eco:standingOnFailure "REFUSED:ARTIFACT_DIGEST_MISMATCH"; eco:remediation "discard artifact and reacquire exact workflow artifact"; eco:retryPolicy "alternative-edge".
