@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure33OntologyParseFailure a eco:TypedFailure,skos:Concept; skos:prefLabel "ONTOLOGY_PARSE_FAILURE"; eco:failurePhase "validation"; eco:standingOnFailure "BUILD_BROKEN"; eco:remediation "repair Turtle/RDF syntax"; eco:retryPolicy "same-subject".
