@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure07UnreceiptedActuation a eco:TypedFailure,skos:Concept; skos:prefLabel "UNRECEIPTED_ACTUATION"; eco:failurePhase "receipt"; eco:standingOnFailure "REFUSED:UNRECEIPTED_ACTUATION"; eco:remediation "require broker receipt before standing advance"; eco:retryPolicy "same-subject".
