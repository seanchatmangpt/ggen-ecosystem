@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure26PackMissing a eco:TypedFailure,skos:Concept; skos:prefLabel "PACK_MISSING"; eco:failurePhase "closure"; eco:standingOnFailure "BLOCKED"; eco:remediation "resolve admitted reusable pack or record unsupported edge"; eco:retryPolicy "alternative-edge".
