@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure31PublicCatalogScopeDrift a eco:TypedFailure,skos:Concept; skos:prefLabel "PUBLIC_CATALOG_SCOPE_DRIFT"; eco:failurePhase "privacy"; eco:standingOnFailure "UNKNOWN"; eco:remediation "refresh owner predicate plus public visibility census"; eco:retryPolicy "new-subject".
