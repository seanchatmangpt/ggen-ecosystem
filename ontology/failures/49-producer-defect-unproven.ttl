@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure49ProducerDefectUnproven a eco:TypedFailure,skos:Concept; skos:prefLabel "PRODUCER_DEFECT_UNPROVEN"; eco:failurePhase "diagnosis"; eco:standingOnFailure "REFUSED:PRODUCER_DEFECT_UNPROVEN"; eco:remediation "demonstrate causal producer failure before repair"; eco:retryPolicy "same-subject".
