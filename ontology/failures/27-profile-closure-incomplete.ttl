@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure27ProfileClosureIncomplete a eco:TypedFailure,skos:Concept; skos:prefLabel "PROFILE_CLOSURE_INCOMPLETE"; eco:failurePhase "closure"; eco:standingOnFailure "PARTIAL_ALIVE"; eco:remediation "resolve repository/pack/capability dependency closure"; eco:retryPolicy "same-subject".
