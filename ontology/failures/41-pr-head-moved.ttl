@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure41PrHeadMoved a eco:TypedFailure,skos:Concept; skos:prefLabel "PR_HEAD_MOVED"; eco:failurePhase "git"; eco:standingOnFailure "REFUSED:PR_HEAD_MOVED"; eco:remediation "reread exact PR head before review or merge"; eco:retryPolicy "new-subject".
