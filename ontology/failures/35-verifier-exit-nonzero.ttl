@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure35VerifierExitNonzero a eco:TypedFailure,skos:Concept; skos:prefLabel "VERIFIER_EXIT_NONZERO"; eco:failurePhase "validation"; eco:standingOnFailure "PARTIAL_ALIVE"; eco:remediation "diagnose failed predicate and repair narrowest cause"; eco:retryPolicy "same-subject".
