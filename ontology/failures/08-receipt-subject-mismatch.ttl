@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure08ReceiptSubjectMismatch a eco:TypedFailure,skos:Concept; skos:prefLabel "RECEIPT_SUBJECT_MISMATCH"; eco:failurePhase "receipt"; eco:standingOnFailure "REFUSED:RECEIPT_SUBJECT_MISMATCH"; eco:remediation "bind receipt to exact admitted subject SHA"; eco:retryPolicy "new-subject".
