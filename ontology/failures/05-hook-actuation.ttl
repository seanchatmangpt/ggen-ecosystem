@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure05HookActuation a eco:TypedFailure,skos:Concept; skos:prefLabel "HOOK_ACTUATION"; eco:failurePhase "authority"; eco:standingOnFailure "REFUSED:HOOK_ACTUATION"; eco:remediation "reduce hook to intent emission"; eco:retryPolicy "same-subject".
