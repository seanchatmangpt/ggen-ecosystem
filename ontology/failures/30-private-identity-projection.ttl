@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure30PrivateIdentityProjection a eco:TypedFailure,skos:Concept; skos:prefLabel "PRIVATE_IDENTITY_PROJECTION"; eco:failurePhase "privacy"; eco:standingOnFailure "REFUSED:PRIVATE_IDENTITY_PROJECTION"; eco:remediation "remove private identity from public projection"; eco:retryPolicy "same-subject".
