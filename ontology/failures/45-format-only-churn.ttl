@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. eco:Failure45FormatOnlyChurn a eco:TypedFailure,skos:Concept; skos:prefLabel "FORMAT_ONLY_CHURN"; eco:failurePhase "manufacture"; eco:standingOnFailure "REFUSED:FORMAT_ONLY_CHURN"; eco:remediation "exclude non-semantic churn from takt"; eco:retryPolicy "same-subject".
