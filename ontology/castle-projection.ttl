eco:FormalTheoryProjection a eco:Capability, skos:Concept ;
    skos:prefLabel "formal theory projection" .
eco:ProofDrivenManufactureResearch a eco:Capability, skos:Concept ;
    skos:prefLabel "proof-driven manufacture research" .
eco:SemanticDocumentProjection a eco:Capability, skos:Concept ;
    skos:prefLabel "semantic document and diagram projection" .
