@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CASTLE v26.9.28 remaining-capability projection.
#
# This graph projects the 23 repositories that CASTLE's sJira crown did not
# retain as irreducible KEEP owners. Projection != ownership and projection !=
# admission. Every edge is CANDIDATE and has authority ceiling CONSTRUCT.
#
# Source crown:
#   seanchatmangpt/castle@c6a69e23fc99a70e78e98436ba7f715fc1099a7b
#   docs/sjira/v26.9.28/repos.ttl
#
# Runtime/product crown remains external to this projection:
#   XaaS   = runtime existence/composition
#   CASTLE = consequential admissibility
#   BRCE   = protected CONSTRUCT -> DO

eco:CastleCapabilityProjection a <http://www.w3.org/2000/01/rdf-schema#Class> .
eco:projectedRepository a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:sourceBranch a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:sourceSha a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:projectedCapability a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:projectionDisposition a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:projectionTarget a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:runtimePlacement a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:projectionStanding a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:authorityCeiling a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:falsifier a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
eco:projectionSource a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .

eco:castle a eco:Profile, prov:Plan ;
    dcterms:title "castle" ;
    eco:profileName "castle" ;
    eco:selectionPolicy "project-non-owner-capabilities-without-promoting-sovereignty" ;
    eco:profileStanding "CANDIDATE" ;
    eco:includesCapability
        eco:LegacyManufactureCompatibility,
        eco:RdfKernelCompatibility,
        eco:ProcessExecutionKernel,
        eco:AshProcessProjection,
        eco:ExternalWorkerProvider,
        eco:ModelProviderBridge,
        eco:WorkSystemAdapter,
        eco:HumanBoardSurface,
        eco:MobileSurface,
        eco:PlanningCenterAdapter,
        eco:DomainApplicationSurface,
        eco:SoftwareConsequenceAdapter,
        eco:StrategyDoctrineKnowledge,
        eco:EngineeringConstitutionKnowledge,
        eco:ProtocolSpecificationKnowledge,
        eco:HistoricalSemanticSource,
        eco:FormalTheoryProjection,
        eco:ProofDrivenManufactureResearch,
        eco:SemanticDocumentProjection,
        eco:ProcessEvidenceCompatibility,
        eco:CapabilityKernelResearch,
        eco:ProofCarryingWorkRuntimeResearch,
        eco:ApplicationConstitutionResearch .

eco:castle-projection-source a prov:Entity ;
    dcterms:identifier "seanchatmangpt/castle@c6a69e23fc99a70e78e98436ba7f715fc1099a7b:docs/sjira/v26.9.28/repos.ttl" ;
    dcterms:title "CASTLE v26.9.28 remaining repository conservation set" .

