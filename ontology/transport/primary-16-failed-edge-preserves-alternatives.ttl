@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. @prefix dcterms:<http://purl.org/dc/terms/>. eco:TransportInvariant16FailedEdgePreservesAlternatives a skos:Concept; skos:prefLabel "Failed Edge Preserves Alternatives"; skos:definition "Transport invariant: failed-edge-preserves-alternatives. Exact admitted subject identity must be preserved across materialization and execution boundaries; transport itself has no ambient DO authority."; dcterms:source "docs/TRANSPORT.md"; eco:standingBoundary "ALIVE requires observed execution against the exact admitted subject"; eco:falsifier "Fail if the transported executable subject cannot be proven identical to the admitted source boundary or if transport acquires ambient actuation authority."; eco:portfolioRole "PRIMARY".
