@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Shard 10 of the local-project-audit repository census extension (2026-08-29).
# Source: real `gh api user/repos` enumeration (owner=seanchatmangpt), filtered to
# visibility=public, fork=false, archived=false -- the "my projects" audit population
# distinct from the 2026-08-28 GitHub-census shards 01-04 (which predate this filter).
# Each entry below is an observation only (see docs/REPOSITORY-CENSUS.md); it grants no
# dependency, capability, profile, or actuation authority by itself.

eco:repo-candidate-tcps-accept-test-2-sandbox a eco:RepositoryCandidate, prov:Entity ;
    dcterms:identifier "seanchatmangpt/tcps-accept-test-2-sandbox" ;
    eco:sourceUrl "https://github.com/seanchatmangpt/tcps-accept-test-2-sandbox" ;
    eco:censusStanding "CANDIDATE" ;
    eco:membershipBasis "observed-public-github-census; ecosystem-membership-not-admitted" ;
    eco:publicProjection true .

