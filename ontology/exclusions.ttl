@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

eco:Exclusion a rdfs:Class .

eco:ExclusionScheme a skos:ConceptScheme ;
    skos:prefLabel "ggen ecosystem exclusions" .

eco:NoAmbientExecution a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "no ambient execution authority" .

eco:NoHookActuation a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "hooks manufacture intents only" .

eco:NoInspectionAsExecution a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "inspection is not execution" .

eco:NoNamedReceiptAsReceipt a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "named receipt is not verified receipt" .

eco:NoProjectionAuthority a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "generated projections are not authority" .

eco:NoRepoAsMount a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "repository object is not a mounted tree" .

eco:NoUnreceiptedActuation a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "no unreceipted actuation" .

eco:NoWorkflowAsSuccess a skos:Concept ;
    skos:inScheme eco:ExclusionScheme ;
    skos:prefLabel "workflow definition is not successful run" .

eco:NoPrivateIdentityProjection a eco:Exclusion ;
    dcterms:title "No private identity projection" ;
    dcterms:title "No private repository identity projection" ;
    dcterms:description "A public projection MUST NOT disclose a non-public repository identity merely because the observer can read it." ;
    dcterms:description "Observation access to a non-public repository does not confer publication authority. Preserve private candidates outside the public graph unless separately authorized." .

eco:PublicProjectionFence a odrl:Policy ;
    dcterms:title "Public ecosystem projection fence" ;
    dcterms:description "The public ggen-ecosystem graph may project a repository identity only when that identity is already public or explicit publication authority exists. Private identities remain outside this public projection." .
