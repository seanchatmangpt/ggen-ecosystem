  eco:productConstitutionOwner "seanchatmangpt/castle" ;
  eco:authorityCeiling "EVIDENCE_UNLESS_SEPARATELY_ADMITTED" ;
  eco:replayPolicy "NON_ACTUATING" ;
  eco:retryPolicy "UNKNOWN_REQUIRES_RECONCILE" ;
  eco:settlementPolicy "AT_MOST_ONE_SETTLEMENT_PER_EXACT_EFFECT" ;
  prov:wasDerivedFrom
    <https://github.com/seanchatmangpt/semantic_bit/commit/a955c773336cdb18fbbb2ca899f1ca0df1ca87f0>,
    <https://github.com/seanchatmangpt/a2a-rs/commit/75ba4a6ea3104c0edb0b31f4286faedf1a6964a6>,
    <https://github.com/seanchatmangpt/mcpp/commit/a0ce275a235a4655f6f76259bc3d1e6d47477c9d>,
    <https://github.com/seanchatmangpt/dteam/commit/27885a8b42cdee2fb096ab585c8c691c9e6f6969>,
    <https://github.com/seanchatmangpt/autotel/commit/52c23c4b960e0d3ecd414b0bce5a35b565c8975d>,
    <https://github.com/seanchatmangpt/mfw/commit/dfd25a63033505be98673d96d5b25c2ce7e666d5>,
    <https://github.com/seanchatmangpt/yawl/commit/db94343f2fb0f1b757d390f54f799924468c1442>,
    <https://github.com/seanchatmangpt/cre/commit/dc763e7e3a0cf9f7cc7cd735c284f6a13e2ca989> .

