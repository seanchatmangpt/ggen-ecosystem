@prefix ocelx: <https://seanchatmangpt.github.io/ggen-ecosystem/ontology/ocel#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ocelx:RepositoryObservedEvent a owl:Class ; rdfs:subClassOf prov:Activity ; ocelx:eventTypeName "repository_observed" ; ocelx:lifecycleStage ocelx:ObserveStage ; ocelx:requiresReceipt false ; skos:prefLabel "repository observed" ; dcterms:description "Records observation of a repository without implying ecosystem admission." .
