@prefix ocelx: <https://seanchatmangpt.github.io/ggen-ecosystem/ontology/ocel#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ocelx:OcelEcosystemProfile a owl:Ontology ;
  dcterms:title "GGen ecosystem OCEL 2.x semantic profile" ;
  dcterms:description "Public-ontology profile for projecting governed GGen ecosystem observations into object-centric event logs without granting ambient execution authority." ;
  dcterms:conformsTo <https://www.ocel-standard.org/> .

ocelx:LifecycleStageScheme a skos:ConceptScheme ; skos:prefLabel "GGen ecosystem OCEL lifecycle stages" .
ocelx:eventTypeName a owl:AnnotationProperty ; rdfs:label "OCEL event type name" .
ocelx:objectTypeName a owl:AnnotationProperty ; rdfs:label "OCEL object type name" .
ocelx:lifecycleStage a owl:AnnotationProperty ; rdfs:label "lifecycle stage" .
ocelx:requiresReceipt a owl:AnnotationProperty ; rdfs:label "requires receipt" .
ocelx:ObserveStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "observe" .
ocelx:AdmissionStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "admit" .
ocelx:ConstructStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "construct" .
ocelx:VerificationStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "verify" .
ocelx:LearningStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "learn" .
ocelx:PublicationStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "publish" .
ocelx:ActuationStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "actuate" .
ocelx:ReplayStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "replay" .
ocelx:StandingStage a skos:Concept ; skos:inScheme ocelx:LifecycleStageScheme ; skos:prefLabel "standing" .
