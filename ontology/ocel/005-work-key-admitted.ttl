@prefix ocelx:<https://seanchatmangpt.github.io/ggen-ecosystem/ontology/ocel#>. @prefix prov:<http://www.w3.org/ns/prov#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>. @prefix dcterms:<http://purl.org/dc/terms/>. @prefix owl:<http://www.w3.org/2002/07/owl#>. @prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#>. ocelx:WorkKeyAdmittedEvent a owl:Class; rdfs:subClassOf prov:Activity; ocelx:eventTypeName "work_key_admitted"; ocelx:lifecycleStage ocelx:AdmissionStage; ocelx:requiresReceipt false; skos:prefLabel "work key admitted"; dcterms:description "Records admission of a disjoint work key after collision checks.".