@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:ShaclBoundaryValidation a eco:Capability, skos:Concept ;
  skos:inScheme eco:CapabilityScheme ;
  skos:prefLabel "SHACL boundary validation" ;
  skos:broader eco:GraphAdmission ;
  skos:scopeNote "Reversible ecosystem capability slice. Admission does not grant ambient DO authority." .
