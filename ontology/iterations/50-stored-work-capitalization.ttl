@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:StoredWorkCapitalization a eco:Capability, skos:Concept ;
  skos:inScheme eco:CapabilityScheme ;
  skos:prefLabel "Stored executable work capitalization" ;
  skos:broader eco:StoredExecutableWork ;
  skos:scopeNote "Reversible ecosystem capability slice. Admission does not grant ambient DO authority." .
