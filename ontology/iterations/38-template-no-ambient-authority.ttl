@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>.
eco:TemplateNoAmbientAuthority a eco:GovernanceInvariant,skos:Concept;skos:prefLabel "template output has no ambient authority";skos:definition "Templates may construct projections but cannot authorize irreversible execution.";eco:falsifier "A template result directly causing DO falsifies this invariant.".
