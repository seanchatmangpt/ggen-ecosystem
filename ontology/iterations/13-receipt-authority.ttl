@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>.
eco:ReceiptAuthorityBinding a eco:GovernanceInvariant,skos:Concept;skos:prefLabel "receipt binds authority";skos:definition "A receipt records the authority under which a consequence was permitted.";eco:falsifier "A consequential receipt without authority identity falsifies this invariant.".
