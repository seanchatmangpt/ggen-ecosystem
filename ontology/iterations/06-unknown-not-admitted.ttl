@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>.
eco:UnknownNotAdmitted a eco:GovernanceInvariant,skos:Concept;skos:prefLabel "unknown is not admitted";skos:definition "Plausibility or incomplete observation cannot promote UNKNOWN to admitted standing.";eco:falsifier "Any admission based only on plausibility falsifies this invariant.".
