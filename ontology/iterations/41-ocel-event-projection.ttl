@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:OcelEventProjection a eco:Capability, skos:Concept ;
  skos:inScheme eco:CapabilityScheme ;
  skos:prefLabel "OCEL event projection" ;
  skos:broader eco:ProcessIntelligence ;
  skos:scopeNote "Reversible ecosystem capability slice. Admission does not grant ambient DO authority." .
