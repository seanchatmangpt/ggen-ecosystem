@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:PublicPrivateBoundary a eco:Capability, skos:Concept ;
  skos:inScheme eco:CapabilityScheme ;
  skos:prefLabel "Public/private publication boundary" ;
  skos:broader eco:EcosystemComposition ;
  skos:scopeNote "Reversible ecosystem capability slice. Admission does not grant ambient DO authority." .
