@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:IdempotentSyncReplay a eco:Capability, skos:Concept ;
  skos:inScheme eco:CapabilityScheme ;
  skos:prefLabel "Idempotent sync replay" ;
  skos:broader eco:DeterministicManufacture ;
  skos:scopeNote "Reversible ecosystem capability slice. Admission does not grant ambient DO authority." .
