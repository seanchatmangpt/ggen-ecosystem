@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:SemanticSourceAuthorityInvariant a eco:GovernanceInvariant, skos:Concept ;
  skos:prefLabel "semantic-source authority invariant" ;
  skos:definition "Ontology, admission, and profile sources outrank their generated projections." ;
  eco:falsifier "Treating a generated projection as a higher-authority editing surface falsifies this invariant." .
