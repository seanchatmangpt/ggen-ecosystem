@prefix eco:<https://ggen.dev/ecosystem#>. @prefix skos:<http://www.w3.org/2004/02/skos/core#>.
eco:PackAdmissionGate a eco:GovernanceInvariant,skos:Concept;skos:prefLabel "pack admission gate";skos:definition "Pack composition must satisfy repository pack-policy gates before manufacture.";eco:falsifier "Manufacture with an unadmitted pack falsifies this invariant.".
