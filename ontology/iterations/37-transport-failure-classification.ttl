@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:TransportFailureClassification a eco:Capability, skos:Concept ;
  skos:inScheme eco:CapabilityScheme ;
  skos:prefLabel "Transport failure classification" ;
  skos:broader eco:Operationalization ;
  skos:scopeNote "Reversible ecosystem capability slice. Admission does not grant ambient DO authority." .
