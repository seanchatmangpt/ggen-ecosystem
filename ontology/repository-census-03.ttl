@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eco:repo-candidate-POWL a eco:RepositoryCandidate, prov:Entity ;
    dcterms:identifier "seanchatmangpt/POWL" ;
    eco:sourceUrl "https://github.com/seanchatmangpt/POWL" ;
    eco:censusStanding "CANDIDATE" ;
    eco:membershipBasis "observed-public-github-census; ecosystem-membership-not-admitted; verified-2026-08-29: public fork of fit-process-mining/POWL; excluded-from-authored-work-audit-population" ;
    eco:forkOf "fit-process-mining/POWL" ;
    eco:censusReverifiedDate "2026-08-29"^^xsd:date ;
    eco:publicProjection true .

