PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#>
PREFIX ex: <https://ggen.io/ecosystem/github-sync#>
# WS1 bootstrap-rail contract: admit-candidate-env
ASK { ex:admit gha:envVar "CANDIDATE_SHA: ${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}" . }
