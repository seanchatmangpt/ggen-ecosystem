PREFIX eco: <https://ggen.dev/ecosystem#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
ASK {
  ?failure a eco:TypedFailure, skos:Concept ;
           skos:prefLabel "EXACT_HEAD_MISMATCH" ;
           eco:failurePhase ?phase ; eco:standingOnFailure ?standing ;
           eco:remediation ?remediation ; eco:retryPolicy ?retryPolicy .
  FILTER(STRLEN(STR(?phase)) > 0 && STRLEN(STR(?standing)) > 0 && STRLEN(STR(?remediation)) > 0 && STRLEN(STR(?retryPolicy)) > 0)
}
