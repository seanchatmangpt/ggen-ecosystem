PREFIX sa2a: <https://seanchatmangpt.github.io/sa2a/diataxis#>
SELECT ?repository ?capability WHERE {
  ?repository a sa2a:RepositoryProfile ; sa2a:exports ?capability .
  FILTER (
    NOT EXISTS { ?capability sa2a:learnedBy ?tutorial } ||
    NOT EXISTS { ?capability sa2a:executedBy ?method } ||
    NOT EXISTS { ?capability sa2a:specifiedBy ?contract } ||
    NOT EXISTS { ?capability sa2a:constrainedBy ?law } ||
    NOT EXISTS { ?capability sa2a:verifiedBy ?gate } ||
    NOT EXISTS { ?capability sa2a:repairedBy ?repair } ||
    NOT EXISTS { ?capability sa2a:evidencedBy ?receipt }
  )
}
ORDER BY ?repository ?capability
