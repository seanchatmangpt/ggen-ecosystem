PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#> PREFIX ex: <https://ggen.io/ecosystem/github-sync#>
# Falsifier: false when admission no longer emits the pack identity receipt.
ASK WHERE { ex:admit gha:runCommand ?v . FILTER(CONTAINS(STR(?v), "GGEN_PACK_RECEIPT")) FILTER(CONTAINS(STR(?v), "json.dumps(admitted")) }
