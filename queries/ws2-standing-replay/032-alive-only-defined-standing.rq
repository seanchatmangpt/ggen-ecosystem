PREFIX eco: <https://ggen.dev/ecosystem#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ASK {
  eco:ALIVE eco:aliveDefinition ?definition .
  FILTER NOT EXISTS {
    ?s skos:inScheme eco:StandingScheme ; eco:aliveDefinition ?other .
    FILTER(?s != eco:ALIVE)
  }
}
