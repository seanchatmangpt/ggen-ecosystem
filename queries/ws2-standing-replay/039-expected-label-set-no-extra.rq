PREFIX eco: <https://ggen.dev/ecosystem#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ASK {
  FILTER NOT EXISTS {
    ?s skos:inScheme eco:StandingScheme ; skos:prefLabel ?label .
    FILTER(?label NOT IN ("UNKNOWN","PARTIAL_ALIVE","ALIVE","BLOCKED","BUILD_BROKEN","UNSUPPORTED","REFUSED"))
  }
}
