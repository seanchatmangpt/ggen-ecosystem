PREFIX eco: <https://ggen.dev/ecosystem#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ASK {
  FILTER NOT EXISTS {
    ?s skos:inScheme eco:StandingScheme .
    FILTER(?s NOT IN (eco:UNKNOWN, eco:PARTIAL_ALIVE, eco:ALIVE, eco:BLOCKED, eco:BUILD_BROKEN, eco:UNSUPPORTED, eco:REFUSED))
  }
}
