PREFIX gha: <http://seanchatmangpt.github.io/packs/github-actions#>
PREFIX ex: <https://ggen.io/ecosystem/github-sync#>
ASK {
  ex:containerBuildPush gha:withParam "tags: ghcr.io/seanchatmangpt/ggen-ecosystem:${{ inputs.image_tag || github.ref_name }},ghcr.io/seanchatmangpt/ggen-ecosystem:latest" .
}
