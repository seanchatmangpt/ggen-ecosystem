@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

eco:ggen-ecosystem
    a dcat:Dataset, prov:Entity ;
    dcterms:title "ggen ecosystem composition graph" ;
    dcterms:identifier "seanchatmangpt/ggen-ecosystem" ;
    dcterms:hasVersion "26.10.1" ;
    dcterms:description "Canonical governed composition, closure, qualification and transport graph for the ggen ecosystem." ;
    eco:owns eco:Composition, eco:Admission, eco:Closure, eco:Qualification, eco:Transport, eco:Standing ;
    eco:doesNotOwn eco:RepositorySourceIdentity, eco:AmbientActuation ;
    eco:defaultProfile eco:cloud-session ;
    eco:maximalProfile eco:everything ;
    eco:manufacturedBy eco:ggen ;
    eco:knowledgeSource eco:ggen-marketplace, eco:affidavit, eco:graphlaw, eco:insa, eco:mfact, eco:castle .

# 2026-10-13 wave: cross-repo capital surfaces. Pack-level facts are recorded as
# annotations on the owning repo's existing node (repo granularity is the only
# granularity this ontology models).
eco:ggen-marketplace
    dcterms:description "Canonical corpus of reusable ggen packs; houses packs/refusal-vocabulary-pack (semantic refusal vocabulary crosswalk) and packs/insa-law-pack (eight-vow insa law pack)." ;
    skos:note "packs/refusal-vocabulary-pack and packs/insa-law-pack are consumed by differential-court test seams in affidavit (strata_refusal_golden_lifecycle, strata_refusal_seam), graphlaw (strata_gate_differential, insa_chain_differential, insa_law_order fixtures) and insa (eight_vow_rdf_differential)." .
eco:affidavit
    dcterms:description "Affidavit receipt plane; differential-court test seams consume ggen-marketplace refusal-vocabulary fixtures." .
eco:graphlaw
    dcterms:description "Graphlaw WASM kernel plane; strata/insa differential-court seams consume ggen-marketplace fixtures." .
eco:insa
    dcterms:description "Insa law plane; eight_vow_rdf_differential court consumes ggen-marketplace insa-law-pack fixtures." .
eco:mfact
    dcterms:description "Mfact formal plane; procint Petri-net witnesses (ProcInt.lean, AxiomAudit.lean, StrataStore.lean) under the eco:Closure evidence ceiling." .
eco:castle
    dcterms:description "Castle evidence plane; QMe/castle-board evidence surfaces (docs/qme-1-reference.md, WBPR_CASTLE_BOARD) over castle-ggen-rdf." .

eco:Composition a skos:Concept ; skos:prefLabel "composition" .
eco:Admission a skos:Concept ; skos:prefLabel "admission" .
eco:Closure a skos:Concept ; skos:prefLabel "closure" .
eco:Qualification a skos:Concept ; skos:prefLabel "qualification" .
eco:Transport a skos:Concept ; skos:prefLabel "transport" .
eco:Standing a skos:Concept ; skos:prefLabel "standing" .
eco:RepositorySourceIdentity a skos:Concept ; skos:prefLabel "independent repository source identity" .
eco:AmbientActuation a skos:Concept ; skos:prefLabel "ambient actuation authority" .
