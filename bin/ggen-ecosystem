#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE="${GGEN_ECOSYSTEM_CACHE:-$ROOT/.cache/ggen-ecosystem}"
GGEN_RELEASE="v26.8.27"
GGEN_ASSET="ggen-x86_64-unknown-linux-gnu.tar.gz"
GGEN_SHA256="ab442ced90a9836fd4eb07a5d61eb58293843cd515d864699fc0d0453444a035"

usage() {
  cat <<'EOF'
Usage:
  ggen-ecosystem manufacture [PROJECT_DIR]
  ggen-ecosystem composition
  ggen-ecosystem igniter-test

Consumers call this wrapper. Direct ggen/ggen-marketplace/ggen_igniter pins are internal to ggen-ecosystem.
EOF
}

resolve_ggen() {
  if [[ -n "${GGEN_ECOSYSTEM_GGEN:-}" ]]; then
    test -x "$GGEN_ECOSYSTEM_GGEN"
    printf '%s\n' "$GGEN_ECOSYSTEM_GGEN"
    return
  fi

  local install="$CACHE/$GGEN_RELEASE"
  local bin="$install/ggen"
  if [[ -x "$bin" ]]; then
    printf '%s\n' "$bin"
    return
  fi

  mkdir -p "$install"
  local archive="$install/$GGEN_ASSET"
  curl --fail --location --retry 3 --retry-all-errors --proto '=https' --tlsv1.2 \
    -o "$archive" "https://github.com/seanchatmangpt/ggen/releases/download/$GGEN_RELEASE/$GGEN_ASSET"
  printf '%s  %s\n' "$GGEN_SHA256" "$archive" | sha256sum --check --strict >&2
  tar -xzf "$archive" -C "$install"
  local found
  found="$(find "$install" -type f -name ggen -print -quit)"
  test -n "$found"
  if [[ "$found" != "$bin" ]]; then cp "$found" "$bin"; fi
  chmod +x "$bin"
  printf '%s\n' "$bin"
}

cmd="${1:-}"
case "$cmd" in
  manufacture)
    project="${2:-$PWD}"
    project="$(cd "$project" && pwd)"
    test -f "$project/ggen.toml"
    test -f "$project/ontology.ttl"
    ggen_bin="$(resolve_ggen)"
    (cd "$project" && "$ggen_bin" sync run)
    ;;
  composition)
    git -C "$ROOT" submodule status --recursive
    printf 'ecosystem=%s\n' "$(git -C "$ROOT" rev-parse HEAD)"
    printf 'ggen=%s\n' "$(git -C "$ROOT/vendor/ggen" rev-parse HEAD)"
    printf 'ggen-marketplace=%s\n' "$(git -C "$ROOT/vendor/ggen-marketplace" rev-parse HEAD)"
    printf 'ggen_igniter=%s\n' "$(git -C "$ROOT/vendor/ggen_igniter" rev-parse HEAD)"
    printf 'autofde-lab=%s\n' "$(git -C "$ROOT/vendor/autofde-lab" rev-parse HEAD)"
    ;;
  igniter-test)
    (cd "$ROOT/vendor/ggen_igniter" && mix deps.get && mix test)
    ;;
  -h|--help|help|'') usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
