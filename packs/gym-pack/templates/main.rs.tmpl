---
to: "src/main.rs"
force: true
shape:
  - vendor/ggen-ecosystem/packs/gym-pack/shapes/gym.shacl.ttl
sparql:
  gym: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id
    WHERE {
      ?gym a sosa:Platform ; dct:identifier ?id .
    }
    ORDER BY ?id
    LIMIT 1
---
mod gym_profile;

fn main() {
    println!("{} | {}", gym_profile::GYM_ID, gym_profile::GYM_TITLE);
    println!("procedures={}", gym_profile::PROCEDURES.len());
    for procedure in gym_profile::PROCEDURES {
        println!("{}|{}|{}", procedure.id, procedure.title, procedure.consequence);
    }
}
