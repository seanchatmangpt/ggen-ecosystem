---
to: "src/gym_profile.rs"
force: true
shape:
  - vendor/ggen-ecosystem/packs/gym-pack/shapes/gym.shacl.ttl
sparql:
  gym: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?title ?description
    WHERE {
      ?gym a sosa:Platform ;
           dct:identifier ?id ;
           dct:title ?title ;
           dct:description ?description .
    }
    ORDER BY ?id
    LIMIT 1
  procedures: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?title ?consequence
    WHERE {
      ?procedure a sosa:Procedure ;
                 dct:identifier ?id ;
                 dct:title ?title ;
                 dct:type ?kind .
      BIND(IF(CONTAINS(STR(?kind), "consequence:do"), "DO", "READ") AS ?consequence)
    }
    ORDER BY ?id
---
//! Manufactured by ggen-ecosystem gym-pack from admitted customer ontology. Do not edit directly.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Procedure {
    pub id: &'static str,
    pub title: &'static str,
    pub consequence: &'static str,
}

{% for row in gym -%}
pub const GYM_ID: &str = "{{ row.id }}";
pub const GYM_TITLE: &str = "{{ row.title }}";
pub const GYM_DESCRIPTION: &str = "{{ row.description }}";
{% endfor %}

pub const PROCEDURES: &[Procedure] = &[
{% for row in procedures -%}
    Procedure { id: "{{ row.id }}", title: "{{ row.title }}", consequence: "{{ row.consequence }}" },
{% endfor -%}
];

pub fn lookup(id: &str) -> Option<&'static Procedure> {
    PROCEDURES.iter().find(|procedure| procedure.id == id)
}
