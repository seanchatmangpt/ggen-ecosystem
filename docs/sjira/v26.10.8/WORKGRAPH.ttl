eco:SJIRA-GGE-2601 a sj:WorkOrder ;
    dcterms:identifier "SJIRA-GGE-2601" ;
    dcterms:title "Re-verify composition-root standing in ecosystem.lock.toml" ;
    sj:acceptance "Lock's recorded standing values re-read from disk and each re-confirmed or corrected with an observed execution receipt: [wasm4pm] standing=PARTIAL_ALIVE; [container] standing=ALIVE (tag v26.10.1, digest sha256:cf0612ae..., observed_success_run 36924410651 at 2026-10-01T21:16:44Z, head e4be6fee); [catalog] standing=PARTIAL_ALIVE (census 2026-08-28, 378 owned repositories, census_base_main_sha c1bb4b8a)."^^xsd:string ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:baseSha "c988e502f5f303bda8e681009ce7c17fb69416e0"^^xsd:string ;
    sj:evidenceCeiling "Campaign doc-graph evidence; receipts cited outside the graph."^^xsd:string ;
    sj:falsifier "Claim without an on-disk receipt binding the exact subject of SJIRA-GGE-2601 refutes."^^xsd:string ;
    sj:originAuthority sj:objective-code-work-authority ;
    sj:repository "seanchatmangpt/ggen-ecosystem"^^xsd:string ;
    sj:standing "UNKNOWN" ;
    sj:subject "seanchatmangpt/ggen-ecosystem:SJIRA-GGE-2601"^^xsd:string .

